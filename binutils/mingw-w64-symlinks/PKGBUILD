pkgname=mingw-w64-binutils-symlinks
pkgver=2.47
_sourcedir=binutils-${pkgver}
pkgrel=1
pkgdesc="Cross binutils for the MinGW-w64 cross-compiler"
arch=('x86_64')
url="http://www.gnu.org/software/binutils"
license=(GPL-2.0-or-later GPL-3.0-or-later LGPL-2.0-or-later LGPL-3.0-or-later GFDL-1.3 FSFAP)
groups=('mingw-w64-toolchain' 'mingw-w64')
provides=('mingw-w64-binutils')
depends=('zlib')
options=('!libtool' '!emptydirs')
validpgpkeys=('3A24BC1E8FB409FA9F14371813FCEF89DD9E3C4F' # Nick Clifton (Chief Binutils Maintainer) <nickc@redhat.com>
              '5EF3A41171BB77E6110ED2D01F3D03348DB1A3E2') # Sam James <sam@cmpct.info>
source=("https://ftp.gnu.org/gnu/binutils/${_sourcedir}.tar.gz"{,.sig}
        0002-check-for-unusual-file-harder.patch
        0010-bfd-Increase-_bfd_coff_max_nscns-to-65279.patch
        2001-ld-option-to-move-default-bases-under-4GB.patch
        2003-Revert-Restore-old-behaviour-of-windres-so-that-opti.patch
        2004-ld-Prevent-_tls_used-and-_load_config_used-from-bein.patch
        reproducible-import-libraries.patch
        libiberty-unlink-handle-windows-nul.patch
)
sha256sums=('0e86bcf998e4fa8fcdd1a4461899dd8efebfb57f6c15e31f6518a9b037d5e8c6b9a6be3fe28b4b1589c8c82e8611e01241dfef4b54543006a07a855cd8754a67'
            'SKIP'
            '2c99345fc575c3a060d6677537f636c6c4154fac0fde508070f3b6296c1060d4'
            '90890cf76f820e61d4eeeef356b0d08ff0c7a90a07691b42a37a1e17abc29cda'
