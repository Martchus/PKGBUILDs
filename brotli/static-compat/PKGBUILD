pkgname=static-compat-brotli
_pkgname=brotli
pkgver=1.2.1
pkgrel=1
pkgdesc='Generic-purpose lossless compression algorithm'
url='https://github.com/google/brotli'
arch=('x86_64')
license=('MIT')
depends=('static-compat-gcc-libs')
makedepends=('static-compat-cmake' 'git')
options=('staticlibs')
source=(${_pkgname}::"git+${url}#tag=v${pkgver}")
sha512sums=('5b75c0bd67e47441aac8d8e67b4f2416f06c2f5e4fb09f1f213ccf313d00a9d08dfda42d59f5133884f980ea712509bbc6f26f4e942316352eb4150b2f16e964')

pkgver() {
  cd ${_pkgname}
  git describe --tags --match 'v*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  source static-compat-environment
  cd ${_pkgname}
  static-compat-cmake -B build \
    -DCMAKE_BUILD_TYPE=Release
  cmake --build build -v
}

check() {
  source static-compat-environment
  cd ${_pkgname}
  cd build
  ctest --output-on-failure --stop-on-failure -j$(nproc)
}

package() {
  source static-compat-environment
  cd ${_pkgname}
  DESTDIR="$pkgdir" cmake --install build
  find "$pkgdir/$static_compat_prefix" -iname '*.so*' -delete
  install -Dm 644 LICENSE -t "$pkgdir/usr/share/licenses/$_pkgname"
}
