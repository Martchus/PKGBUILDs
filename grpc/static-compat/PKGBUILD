_pkgname=grpc
pkgname=static-compat-$_pkgname
pkgver=1.84.0
_protobuf_ver=36.1
pkgrel=1
pkgdesc="High performance, open source, general RPC framework that puts mobile and HTTP/2 first"
arch=('x86_64')
url='https://grpc.io'
license=('Apache-2.0')
depends=(
  'static-compat-abseil-cpp'
  'static-compat-c-ares'
  'static-compat-openssl'
  'static-compat-protobuf'
  'static-compat-re2'
)
makedepends=(
  'static-compat-cmake'
  'ninja'
  'git'
)
source=(
    "${_pkgname}::git+https://github.com/grpc/grpc.git#tag=v$pkgver"
    "${_pkgname}-grpc-proto::git+https://github.com/grpc/grpc-proto.git"
    "${_pkgname}-googletest::git+https://github.com/google/googletest.git"
    "https://github.com/protocolbuffers/protobuf/archive/v${_protobuf_ver}/protobuf-${_protobuf_ver}.tar.gz")
sha256sums=('1c63b6bb0b846345491c00e00db11694a78a9e61f24f580252fa2e1ffbad056f'
            'SKIP'
            'SKIP'
            '7a7baff8207a57f3fe5c233d432a09eba67bdfb55a3145839d0817cae8e807a4')

prepare() {
  source static-compat-environment
  cd "$srcdir/$_pkgname"

  if ! pkgconf protobuf --exact-version=$_protobuf_ver.0; then
    echo "protobuf version mismatch"
    exit 1
  fi

  git submodule init

  git config submodule."third_party/googletest".url "${srcdir}/${_pkgname}"-googletest
  git config submodule."third_party/grpc-proto".url "${srcdir}/${_pkgname}"-grpc-proto
  git -c protocol.file.allow=always submodule update --init -- third_party/grpc-proto third_party/googletest

  # CMake only downloads third party depends when folder does not exist
  rmdir third_party/{cel-spec,envoy-api,xds,googleapis,protoc-gen-validate}

  # use system protobuf for grpcio_tools
  sed -r -i \
      -e '/^CC_FILES=\[/,/\]/{/^CC_FILES=\[/n;/\]/!d;}' \
      -e '/^CC_INCLUDES=\[/,/\]/{/^CC_INCLUDES=\[/n;/\]/!d;}' \
      -e "s@^(PROTO_INCLUDE=')[^']+'@\1/usr/include'@" \
      -e "s@^(\s*').*/(google/protobuf/.*\.proto',?)\$@\1\2@" \
      -e '/^PROTOBUF_SUBMODULE_VERSION=/d' \
      tools/distrib/python/grpcio_tools/protoc_lib_deps.py
  ln -s ../../../.. tools/distrib/python/grpcio_tools/grpc_root
}

build() {
  source static-compat-environment
  cd "$srcdir/$_pkgname"

  # Workaround for protobuf 34.0+ until https://github.com/grpc/grpc/issues/41755 has been fixed.
  if [[ "$(pacman -Q static-compat-protobuf | grep -Po '(?<= )[0-9.]+(?=-)')" != "$_protobuf_ver" ]]; then
    echo 'error: protobuf version mismatch, please update $_protobuf_ver in the PKGBUILD' >&2
    exit 1
  fi
  export CXXFLAGS+=" -isystem${srcdir}/protobuf-${_protobuf_ver}/src"

  static-compat-cmake -Bbuild \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_CXX_FLAGS="${CXXFLAGS} -DNDEBUG -Wno-attributes -Wno-deprecated-declarations -Wno-return-type -Wno-non-virtual-dtor" \
    -DgRPC_INSTALL=ON \
    -DBUILD_SHARED_LIBS=OFF \
    -DCMAKE_CXX_STANDARD=17 \
    -DCMAKE_INSTALL_PREFIX=/usr/static-compat \
    -DCMAKE_SKIP_RPATH=ON \
    -DgRPC_BUILD_TESTS=OFF \
    -DgRPC_BUILD_CODEGEN=ON \
    -DgRPC_ZLIB_PROVIDER='package' \
    -DgRPC_CARES_PROVIDER='package' \
    -DgRPC_RE2_PROVIDER='package' \
    -DgRPC_SSL_PROVIDER='package' \
    -DgRPC_PROTOBUF_PROVIDER='package' \
    -DgRPC_ABSL_PROVIDER:STRING='package' \
    -DgRPC_USE_PROTO_LITE=OFF \
    -DgRPC_USE_SYSTEMD=OFF \
    -DgRPC_BUILD_GRPC_CPP_PLUGIN=ON \
    -DgRPC_BUILD_GRPC_CSHARP_PLUGIN=OFF \
    -DgRPC_BUILD_GRPC_NODE_PLUGIN=OFF \
    -DgRPC_BUILD_GRPC_OBJECTIVE_C_PLUGIN=OFF \
    -DgRPC_BUILD_GRPC_PHP_PLUGIN=OFF \
    -DgRPC_BUILD_GRPC_PYTHON_PLUGIN=OFF \
    -DgRPC_BUILD_GRPC_RUBY_PLUGIN=OFF \
    -GNinja

  cd build
  cmake --build .
}

package() {
  cd "$srcdir/$_pkgname/build"
  DESTDIR="$pkgdir" cmake --install .
  install -Dm644 ../LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
