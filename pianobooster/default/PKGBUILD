_pkgname=pianobooster
pkgname=pianobooster
pkgver=1397.a94e4ed
pkgrel=1
pkgdesc='A MIDI file player that teaches you how to play the piano (with additional patches)'
arch=('x86_64')
url='https://github.com/Martchus/PianoBooster'
license=('GPL3')
depends=(
    'glibc'
    'libgcc'
    'libstdc++'
    'glu'
    'qt6-base'
    'hicolor-icon-theme'
)
makedepends=(
    'c++utilities'
    'qtutilities'
    'fluidsynth'
    'rtmidi'
    'git'
    'cmake'
    'clang'
    'qt6-tools'
    'qt6-declarative'
    'ninja'
)
source=("${_pkgname}::${MARTCHUS_GIT_URL_PREFIX:-git+https://github.com/Martchus}/PianoBooster.git#branch=custom")
sha256sums=(SKIP)

pkgver() {
    echo "$(git -C "${_pkgname}" rev-list --count HEAD).$(git -C "${_pkgname}" rev-parse --short HEAD)"
}

build () {
    local cmake_options=(
        -B build
        -S "${_pkgname}"
        -G Ninja
        -D CMAKE_BUILD_TYPE=Release
        -D CMAKE_INSTALL_PREFIX=/usr
        -D BUILD_SHARED_LIBS=ON
        -D QT_PACKAGE_PREFIX=Qt6
        -D BUILTIN_TRANSLATIONS=ON
        -D BUILTIN_TRANSLATIONS_OF_QT=OFF
        -D WITH_INTERNAL_FLUIDSYNTH=ON
        -D WITH_MAN=ON
        -D USE_SYSTEM_FONT=ON
        -D USE_FTGL=OFF
        -D USE_JACK=ON
        -D USE_BUNDLED_RTMIDI=OFF
    )
    cmake "${cmake_options[@]}"
    cmake --build build
}

package () {
  depends+=(
      'libGL.so'
      'libqtutilities.so'
      'libfluidsynth.so'
      'librtmidi.so'
  )
  DESTDIR="${pkgdir}" cmake --install build
}
