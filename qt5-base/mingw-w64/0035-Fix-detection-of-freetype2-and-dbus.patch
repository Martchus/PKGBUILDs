From 00b7ce50ecb99680e58cb916566a9a757509f34c Mon Sep 17 00:00:00 2001
From: Martchus <martchus@gmx.net>
Date: Sun, 13 Sep 2026 13:39:37 +0200
Subject: [PATCH 35/35] Fix detection of freetype2 and dbus

Change-Id: I89085b5c40754c84482af4fb6d94ef4547982c09
---
 configure.json         | 2 +-
 src/gui/configure.json | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/configure.json b/configure.json
index ed5ca2ee3a1..8a10cee57c3 100644
--- a/configure.json
+++ b/configure.json
@@ -193,7 +193,7 @@
                 "main": "(void) dbus_bus_get_private(DBUS_BUS_SYSTEM, (DBusError *)NULL);",
                 "qmake": "static: DEFINES += DBUS_STATIC_BUILD"
             },
-            "headers": "dbus/dbus.h",
+            "headers": "dbus-1.0/dbus/dbus.h",
             "sources": [
                 { "type": "pkgConfig", "args": "dbus-1 >= 1.2" },
                 {
diff --git a/src/gui/configure.json b/src/gui/configure.json
index 429ab91c98e..389adbb85ed 100644
--- a/src/gui/configure.json
+++ b/src/gui/configure.json
@@ -236,7 +236,7 @@
                     "FT_Face face = 0;"
                 ]
             },
-            "headers": "ft2build.h",
+            "headers": "freetype2/ft2build.h",
             "sources": [
                 { "type": "pkgConfig", "args": "--libs freetype2", "condition": "features.shared" },
                 { "libs": "-lfreetype -lharfbuzz -lfreetype -lbrotlidec -lbrotlicommon -lglib-2.0 -lintl -lws2_32 -lole32 -lwinmm -lshlwapi -lpcre2-8 -lintl -lpcre2-8 -lintl -liconv -lgraphite2 -lbz2", "condition": "!features.shared && !config.wasm" },
-- 
2.55.0

