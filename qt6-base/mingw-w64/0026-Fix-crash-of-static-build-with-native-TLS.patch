From 66e84e8a22e64d3c6187fb5c23cc44cd73a29fba Mon Sep 17 00:00:00 2001
From: Martchus <martchus@gmx.net>
Date: Wed, 16 Sep 2026 01:58:24 +0200
Subject: [PATCH 26/26] Fix crash of static build with native TLS

Change-Id: I65bc24c2a6a73730f018fad646b49c0f0c121476
---
 src/corelib/thread/qthread_win.cpp | 28 ++++++++++++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/src/corelib/thread/qthread_win.cpp b/src/corelib/thread/qthread_win.cpp
index 2795d82de1e..c2ca8c1a5dc 100644
--- a/src/corelib/thread/qthread_win.cpp
+++ b/src/corelib/thread/qthread_win.cpp
@@ -85,8 +85,31 @@ static QThreadData *get_thread_data()
     return currentThreadData;
 }
 
-static void set_thread_data(QThreadData *data) noexcept
-{
+#if defined(Q_CC_MINGW)
+static DWORD qt_current_thread_data_tls_index = TLS_OUT_OF_INDEXES;
+
+static void QT_WIN_CALLBACK qt_destroy_current_thread_data() {
+    if (qt_current_thread_data_tls_index != TLS_OUT_OF_INDEXES) {
+        auto *data = static_cast<QThreadData *>(TlsGetValue(qt_current_thread_data_tls_index));
+        if (data) {
+            TlsSetValue(qt_current_thread_data_tls_index, nullptr);
+            destroy_current_thread_data(data);
+        }
+    }
+}
+#endif
+
+static void set_thread_data(QThreadData *data) noexcept {
+#if defined(Q_CC_MINGW)
+    if (qt_current_thread_data_tls_index == TLS_OUT_OF_INDEXES) {
+        qt_current_thread_data_tls_index = TlsAlloc();
+        qAddPostRoutine(qt_destroy_current_thread_data);
+    }
+    if (data && !TlsGetValue(qt_current_thread_data_tls_index)) {
+        QThreadStoragePrivate::init();
+    }
+    TlsSetValue(qt_current_thread_data_tls_index, data);
+#else
     if (data) {
         struct Cleanup {
             Cleanup() { QThreadStoragePrivate::init(); }
@@ -94,6 +117,7 @@ static void set_thread_data(QThreadData *data) noexcept
         };
         static thread_local Cleanup currentThreadCleanup;
     }
+#endif
     currentThreadData = data;
 }
 
-- 
