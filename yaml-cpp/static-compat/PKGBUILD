_pkgname=yaml-cpp
pkgname=static-compat-$_pkgname
pkgver=0.9.0
pkgrel=1
pkgdesc="YAML parser and emitter in C++, written around the YAML 1.2 spec"
arch=(x86_64)
url="https://github.com/jbeder/yaml-cpp"
license=('MIT')
depends=(static-compat-gcc)
makedepends=(
  static-compat-cmake
  git
)
source=(
  git+$_url.git?signed#tag=v$pkgver
)
source=("git+$url.git#tag=yaml-cpp-$pkgver")
b2sums=('757d0b3724536b411b6c0e505540e02117c06449ddc5059b24f9a59bbdbd1fab8710dd1746c10d17ad61decc5cd2bd1c081791a06b79af1fe6aa3a50dbe238d5')

build() {
  source static-compat-environment
  export CXXFLAGS+=' -Wno-error=narrowing'
  local cmake_options=(
    -B build
    -D CMAKE_BUILD_TYPE=None
    -S $_pkgname
    -W no-dev
    -DYAML_CPP_BUILD_TESTS=ON
    -DBUILD_SHARED_LIBS=OFF
    -DYAML_BUILD_SHARED_LIBS=OFF
  )
  static-compat-cmake "${cmake_options[@]}"
  cmake --build build --verbose
}

check() {
  source static-compat-environment
  ctest --test-dir build --output-on-failure
}

package() {
  source static-compat-environment
  DESTDIR="$pkgdir" cmake --install build
  install -vDm 644 $_pkgname/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
